# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Calendar API (OAuth2 — sync ferie su Google Calendar)
# Abilita "Google Calendar API" sul progetto Google Cloud, crea credenziali OAuth
# "Web application" e aggiungi il Redirect URI: {origine}/api/google/callback
# (es. https://tuo-dominio/api/google/callback e http://localhost:3000/api/google/callback).
# Scope usati: calendar + userinfo.email. Il collegamento si fa da /admin/settings.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Maps — Routes API (calcolo distanza casa→ufficio nel profilo)
# Abilita "Routes API" sul progetto Google Cloud e incolla la chiave.
# NB: la vecchia "Distance Matrix API" è legacy → REQUEST_DENIED. Usa Routes API.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Token opzionale per proteggere l'endpoint pubblico /api/emergency/on-call
# (se impostato, la richiesta deve passare ?token=... o header x-emergency-token)
EMERGENCY_ONCALL_TOKEN=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Anthropic Claude API (per AI Assistant reperibilità)
ANTHROPIC_API_KEY=sk-ant-...

# Chiave di cifratura AES-256-GCM (riusabile per più integrazioni)
# Usata per cifrare credenziali sensibili (es. KEROS) prima di salvarle su Supabase.
#
# Genera una chiave sicura con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️  Senza questa chiave le integrazioni cifrate non funzionano.
# ⚠️  Non cambiare questa chiave dopo aver salvato credenziali cifrate
#      (i valori diventerebbero illeggibili — riconfigura da UI).
ENCRYPTION_KEY=genera_una_chiave_hex_64_caratteri_con_il_comando_sopra
